<% const cardColor=item.color || 'var(--primary)' ; %>
    <div class="col-md-4 mb-4 reveal" data-tilt data-tilt-max="5" data-tilt-speed="400">
        <a href="/study/<%= type %>s/<%= item.id %>" class="text-decoration-none h-100">
            <div class="glass-card p-4 border-top border-4" style="border-top-color: <%= cardColor %> !important;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="fs-1 shadow-sm rounded-4 p-3 bg-white bg-opacity-10" style="color: <%= cardColor %>;">
                        <i
                            class="<%= item.icon || (type === 'topic' ? 'fas fa-file-alt' : 'fas fa-graduation-cap') %>"></i>
                    </div>
                    <% if (item.difficulty) { %>
                        <span class="badge badge-<%= item.difficulty %> rounded-pill px-3 py-2 fw-bold">
                            <%= item.difficulty.toUpperCase() %>
                        </span>
                        <% } %>
                </div>

                <h4 class="outfit text-main mb-2">
                    <%= item.name %>
                </h4>
                <p class="text-muted small flex-grow-1">
                    <%= item.description %>
                </p>

                <% if (type==='topic' ) { %>
                    <div class="mt-3">
                        <div class="progress rounded-pill bg-light" style="height: 6px;">
                            <div class="progress-bar bg-gradient"
                                style="width: <%= item.status === 'completed' ? '100%' : '0%' %>"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-2 small">
                            <span class="text-muted">Progress</span>
                            <span class="fw-bold <%= item.status === 'completed' ? 'text-success' : 'text-primary' %>">
                                <%= item.status==='completed' ? 'Done' : '0%' %>
                            </span>
                        </div>
                    </div>
                    <% } else { %>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="small text-muted font-monospace"><i class="fas fa-layer-group me-1"></i> Course
                                Roadmap</span>
                            <i class="fas fa-chevron-right text-primary opacity-50"></i>
                        </div>
                        <% } %>
            </div>
        </a>
    </div>

    <style>
        .badge-easy {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        .badge-medium {
            background: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.2);
        }

        .badge-hard {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.2);
        }
    </style>