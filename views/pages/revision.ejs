<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&family=Inter:wght@400;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg: #0f172a;
            --primary: #6366f1;
            --glass: rgba(255, 255, 255, 0.05);
            --border: rgba(255, 255, 255, 0.1);
        }

        body {
            background: var(--bg);
            color: #f1f5f9;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .outfit {
            font-family: 'Outfit', sans-serif;
        }

        .focus-container {
            max-width: 900px;
            margin: 50px auto;
            padding: 0 20px;
            flex-grow: 1;
        }

        .glass-panel {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            border-radius: 30px;
            padding: 40px;
        }

        .flashcard-container {
            perspective: 1000px;
            height: 300px;
            margin-bottom: 40px;
        }

        .flashcard {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.8s;
            transform-style: preserve-3d;
            cursor: pointer;
        }

        .flashcard.flipped {
            transform: rotateY(180deg);
        }

        .flashcard-front,
        .flashcard-back {
            position: absolute;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            padding: 30px;
            font-size: 1.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .flashcard-front {
            background: linear-gradient(135deg, #6366f1, #a855f7);
            color: white;
        }

        .flashcard-back {
            background: #1e293b;
            color: #f1f5f9;
            transform: rotateY(180deg);
            border: 2px solid var(--primary);
        }

        .revision-point {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 15px;
            border-left: 4px solid var(--primary);
            transition: transform 0.3s;
        }

        .revision-point:hover {
            transform: translateX(10px);
            background: rgba(255, 255, 255, 0.05);
        }

        @media print {
            .no-print {
                display: none;
            }

            body {
                background: white;
                color: black;
                padding: 0;
            }

            .glass-panel {
                background: none;
                border: none;
                padding: 0;
                color: black;
            }

            .revision-point {
                border: 1px solid #ddd;
                color: black;
            }
        }
    </style>
</head>

<body>
    <nav class="no-print p-4">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="javascript:window.close()" class="text-white text-decoration-none fw-bold">
                <i class="fas fa-arrow-left me-2 text-primary"></i> Exit Focus Mode
            </a>
            <button onclick="window.print()" class="btn btn-outline-primary rounded-pill px-4">
                <i class="fas fa-print me-2"></i> Print Guide
            </button>
        </div>
    </nav>

    <div class="focus-container">
        <div class="text-center mb-5 reveal">
            <h6 class="text-primary text-uppercase tracking-widest fw-bold outfit mb-2">Focus Mode</h6>
            <h1 class="display-4 fw-bold outfit mb-2">
                <%= topic.name %>
            </h1>
            <p class="text-muted">Master this concept with interactive flashcards and key condensed points.</p>
        </div>

        <!-- Flashcard -->
        <div class="flashcard-container reveal" data-reveal-delay="200">
            <div class="flashcard" id="card">
                <div class="flashcard-front">
                    <div class="text-center">
                        <i class="fas fa-question-circle mb-3 fs-1 opacity-50"></i>
                        <p class="mb-0 fw-bold outfit">What is the core concept of <%= topic.name %>?</p>
                        <small class="opacity-75 mt-3 d-block">Click to flip</small>
                    </div>
                </div>
                <div class="flashcard-back">
                    <div class="text-center">
                        <p class="mb-0 outfit">
                            <%= topic.description.split('.')[0] %>.
                        </p>
                        <small class="text-primary mt-3 d-block">Mastered! Click to flip back</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-panel mb-5 reveal" data-reveal-delay="400">
            <h4 class="outfit fw-bold mb-4"><i class="fas fa-bolt text-warning me-2"></i>Key Summary Points</h4>
            <div class="revision-list">
                <% topic.description.split('. ').forEach((point, i) => { %>
                    <% if (point.trim()) { %>
                        <div class="revision-point reveal" data-reveal-delay="<%= 500 + (i * 100) %>">
                            <div class="d-flex align-items-start gap-3">
                                <span class="bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1 small fw-bold">0<%= i+1 %></span>
                                <p class="mb-0 lh-lg"><%= point.trim() %><%= point.endsWith(' .') ? '' : '.' %>
                    </p>
            </div>
        </div>
        <% } %>
            <% }) %>
    </div>
    </div>

    <div class="glass-panel mb-5 reveal no-print">
        <h5 class="outfit fw-bold mb-3">Formula Sidebar / Quick Ref</h5>
        <div class="p-3 bg-white bg-opacity-5 rounded-4 font-monospace small">
            // Quick Reference Guide<br>
            - Topic Complexity: <%= topic.difficulty.toUpperCase() %><br>
                - Primary Category: Focus Module<br>
                - Learning Path: Subject ID <%= topic.subject_id %>
        </div>
    </div>
    </div>

    <script>
        document.getElementById('card').addEventListener('click', function () {
            this.classList.toggle('flipped');
        });

        // Simple Reveal logic for standalone page
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    setTimeout(() => entry.target.classList.add('reveal-active'), entry.target.dataset.revealDelay || 0);
                }
            });
        });
        document.querySelectorAll('.reveal').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'all 0.8s ease';
            observer.observe(el);
        });
    </script>
    <style>
        .reveal-active {
            opacity: 1 !important;
            transform: translateY(0) !important;
        }
    </style>
</body>

</html>